# Copy to .env for `task run` and `task test:integration`. .env is gitignored.

# Listen address. Defaults to 127.0.0.1:8080 (loopback only).
# GO_MCP_TEMPLATE_ADDR=127.0.0.1:8080

# trace, debug, info (default), warn or error.
# GO_MCP_TEMPLATE_LOG_LEVEL=info

# Serve without auth beyond loopback (trusted networks only).
# GO_MCP_TEMPLATE_ALLOW_UNAUTHENTICATED=false

# Telemetry: off until an OTLP endpoint is set. Exports traces and metrics over
# OTLP HTTP/protobuf (port 4318 on most collectors; grpc isn't supported). Every
# MCP call gets a span with its response size and a rough token estimate. The
# standard OTEL_* variables apply (OTEL_SERVICE_NAME, OTEL_RESOURCE_ATTRIBUTES,
# OTEL_EXPORTER_OTLP_HEADERS, OTEL_SDK_DISABLED, ...).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# MCP auth: set an issuer to require OAuth bearer tokens on the MCP endpoint.
# GO_MCP_TEMPLATE_OIDC_ISSUER=https://auth.example.com
# GO_MCP_TEMPLATE_OIDC_RESOURCE=https://go-mcp-template.example.com
# GO_MCP_TEMPLATE_OIDC_SCOPES=mcp
# GO_MCP_TEMPLATE_OIDC_REQUIRE_AT_JWT=true
